# Demo mode (default) — no MSSQL required, uses built-in HK property data
DATA_MODE=memory
APP_ENV=local
PORT=8080

# Switch to real Azure SQL / MSSQL (requires the credentials below)
# DATA_MODE=mssql
# DB_HOST=tf-sql-server-01.database.windows.net
# DB_PORT=1433
# DB_NAME=properties
# DB_USER=sqladmin
# DB_PASSWORD=<set-your-password>
# DB_ENCRYPT=1
# DB_TRUST_SERVER_CERT=0
